# LMD-NG (Linux Malware Detect - Next Generation) Configuration Example
# This file contains the default configuration values for LMD-NG.
# Copy this file to `config.yaml` to customize your settings.

app:
  base_path: "."
  signatures_dir: "./sigs"
  clamav_dir: "./clamav"
  quarantine_dir: "./quarantine"
  logs_dir: "./logs"

logging:
  level: "info"
  output: "file"
  filepath: "./logs/lmd-ng.log"
  max_size: 10
  max_backups: 7
  max_age: 1
  compress: true

server:
  network: "unix"                    # "unix" (default) or "tcp"
  socket_path: "./lmd-ng.sock"       # Unix socket path (used when network=unix)
  address: "127.0.0.1:7890"          # TCP listen address (used when network=tcp)
  socket_backlog: 1024               # Listen backlog for DBS server socket
  connection_pool_limit: 256         # Max reusable DBS client connections
  stream_buffer_limit: "10M"
  tls:
    # TLS is always enabled (no toggle) to prevent payload tampering
    auto_cert: true                  # Auto-generate self-signed certs on any command
    certs_dir: "./certs"             # Directory for auto-generated certificates
    cert_file: ""                    # Server certificate (auto-generated if auto_cert=true)
    key_file: ""                     # Server key
    ca_file: ""                      # CA certificate for client verification

quarantine:
  enabled: true
  path: "./quarantine"
  enable_encryption: true
  encryption_key: "CHANGE-THIS-TO-YOUR-SECRET-KEY"
  # Max file size to quarantine. Larger files are refused (ErrFileTooLarge) and
  # not quarantined; enforced in Quarantine/Restore/ExportTo. Default: 20M.
  max_file_size: "20M"

monitor:
  paths:
    - "/home"
    - "/var/www"
  exclude_dirs:
    - "/proc"
    - "/sys"
    - "/dev"

scanner:
  signature_path: "./sigs"
  clamav_enabled: false
  clamav_db_path: "./clamav"
  clamav_hex_depth: 65536
  enabled_heuristics:                 # Heuristic detection methods
    - "hex"                           # Possible values: "hex", "ndb"
  min_filesize: 0
  max_filesize: 20M
  max_depth: 0
  max_symlink_depth: 0                # Max symlink recursion depth (0 = no limit, hard cap 255)
  hex_depth: 262144                   # Maldet default: 256KB (~98.9% pattern coverage)
  cpu_limit: 0                        # 0 = auto-detect (uses half of available CPU cores)
  concurrency_limit: 192              # Max concurrent DBS scan requests (DBS client path)
  ignore_root: false
  ignore_users: []
  ignore_groups: []
  include_regex: ""
  exclude_regex: ""
  hash_allowlist_paths: []            # Suppress MD5/SHA256 detections under these path prefixes
  scan_ignore_file_patterns:          # Glob patterns for filename exclusion (empty = defaults below)
    # Extension shorthand: ".log" auto-expands to "*.log"
    # --- Archives ---
    - ".tar"
    - ".gz"
    - ".bz2"
    - ".7z"
    - ".rar"
    - ".arj"
    - ".cab"
    - ".iso"
    # --- VM/Disk ---
    - ".vmdk"
    - ".vdi"
    - ".vhd"
    - ".vhdx"
    - ".qcow2"
    - ".img"
    - ".dmg"
    # --- Logs ---
    - ".log"
    - ".journal"
    # --- Cache/Temp ---
    - ".cache"
    - ".tmp"
    - ".temp"
    # --- Editor/System Artifacts ---
    - ".swp"
    - ".swo"
    - ".lock"
    - ".pid"
    # --- LMD-NG Internal Artifacts ---
    - "lmd-scan-*"
    # --- Office Temp Lock Files ---
    - "~$*"

scheduler:
  update_interval: "@daily"
  scan_interval: "@every 4h"

updater:
  auto_upgrade_binary: false
  auto_update_signatures: true
  remote_uri_timeout: "30s"
  signature_pack_url: "https://cdn.rfxn.com/downloads/maldet-sigpack.tgz"
  signature_version_url: "https://cdn.rfxn.com/downloads/maldet.sigs.ver"
  # The RFXN CDN publishes maldet-sigpack.tgz.sha256, so no manual URL is needed
  signature_checksum_suffix: ".sha256"
  # Explicit override for the checksum file URL
  signature_checksum_url: ""
  clamav_update_enabled: false
  clamav_mirror_url: "https://database.clamav.net"
  clamav_databases:
    - "daily.cvd"
    - "bytecode.cvd"
    - "main.cvd"

notification:
  email:
    enabled: false
    smtp_host: "smtp.example.com"
    smtp_port: 587
    smtp_username: "user@example.com"
    smtp_password: "secretpassword"
    # Set to true for port 465, false for 587
    smtp_use_ssl_tls: false
    sender: "lmd-ng@example.com"
    recipients:
      - "admin@example.com"

  telegram:
    enabled: false
    bot_token: "YOUR_TELEGRAM_BOT_TOKEN"
    chat_id: "YOUR_TELEGRAM_CHAT_ID"

  discord:
    enabled: false
    # Create via Server Settings > Integrations > Webhooks. Treat URL as secret.
    webhook_url: "YOUR_DISCORD_WEBHOOK_URL"

  slack:
    enabled: false
    # Create via api.slack.com > Apps > Incoming Webhooks. Treat URL as secret.
    webhook_url: "YOUR_SLACK_WEBHOOK_URL"
